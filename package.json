{
  "name": "career-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "generate": "tsx scripts/generate-career.ts",
    "scan": "tsx scripts/scan.ts",
    "evals": "tsx evals/run.ts",
    "smoke": "tsx evals/smoke.ts",
    "postinstall": "node -e \"require('node:fs').rmSync('node_modules/deepeval/dist/telemetry.js',{force:true})\"",
    "phoenix:setup": "tsx evals/phoenix/setup.ts",
    "phoenix:datasets": "tsx evals/phoenix/datasets.ts",
    "phoenix:experiment": "tsx evals/phoenix/experiment.ts",
    "phoenix:evaluate": "tsx evals/phoenix/experiment.ts evaluate"
  },
  "devDependencies": {
    "@arizeai/phoenix-client": "7.18.2",
    "@arizeai/phoenix-otel": "2.3.0",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@types/node": "^26.6.6",
    "deepeval": "0.9.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0"
  },
  "overrides": {
    "@arizeai/phoenix-client": {
      "@anthropic-ai/sdk": "$@anthropic-ai/sdk"
    }
  }
}
